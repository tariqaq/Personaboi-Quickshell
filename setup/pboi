#!/usr/bin/env bash
set -euo pipefail

if [[ "$EUID" -eq 0 ]]; then
    echo "Do not run pboi with sudo or as root." >&2
    echo "Run pboi as your normal desktop user so it updates that user's Personaboi files." >&2
    exit 1
fi

REPO_URL="https://github.com/tariqaq/Personaboi-Quickshell.git"
BRANCH="main"
TARGET_QS="$HOME/.config/quickshell/persona"
TARGET_HYPR="$HOME/.config/hypr"
TARGET_ENV="$HOME/.config/environment.d"
STATE_DIR="$HOME/.local/share/personaboi"
STATE_COMMIT="$STATE_DIR/commit"
STATE_VERSION="$STATE_DIR/version"
CLI_TARGET="$HOME/.local/bin/pboi"
LOG_DIR="$HOME/.local/state/personaboi/logs"
PBOI_TMPDIR=""

mkdir -p "$LOG_DIR"
PBOI_LOG_FILE="$LOG_DIR/pboi-$(date '+%Y%m%d-%H%M%S').log"
exec > >(tee -a "$PBOI_LOG_FILE") 2>&1
printf '[%s] pboi start: user=%s command=%q\n' "$(date '+%F %T %z')" "$USER" "${*:-help}"
trap 'rc=$?; printf "[%s] ERROR rc=%s line=%s command=%q\n" "$(date "+%F %T %z")" "$rc" "$LINENO" "$BASH_COMMAND" >&2' ERR

cleanup() {
    if [[ -n "${PBOI_TMPDIR:-}" && -d "$PBOI_TMPDIR" ]]; then
        rm -rf -- "$PBOI_TMPDIR"
    fi
    printf '[%s] pboi finished. Log: %s\n' "$(date '+%F %T %z')" "$PBOI_LOG_FILE"
}
trap cleanup EXIT

print_version() {
    local version="unknown"
    if [[ -f "$TARGET_QS/VERSION" ]]; then
        version="$(tr -d '[:space:]' < "$TARGET_QS/VERSION")"
    elif [[ -f "$STATE_VERSION" ]]; then
        version="$(tr -d '[:space:]' < "$STATE_VERSION")"
    fi
    printf 'Personaboi v%s\n' "$version"
}

show_help() {
    cat <<'EOF'
Personaboi updater

Usage:
  pboi update      Pull and apply the latest Personaboi setup
  pboi version     Show the installed Personaboi version
  pboi changelog   Show the installed changelog
  pboi help        Show this help
EOF
}

show_changelog() {
    if [[ -f "$TARGET_QS/CHANGELOG.md" ]]; then
        cat "$TARGET_QS/CHANGELOG.md"
    else
        echo "No installed changelog found. Run: pboi update"
    fi
}

update_personaboi() {
    for cmd in git rsync sed; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "Missing required command: $cmd" >&2
            exit 1
        fi
    done

    PBOI_TMPDIR="$(mktemp -d "${TMPDIR:-/tmp}/pboi-update.XXXXXX")"
    local tmpdir="$PBOI_TMPDIR"

    echo "Checking Personaboi updates..."
    git clone --quiet --depth 50 --branch "$BRANCH" "$REPO_URL" "$tmpdir/repo"

    local new_commit new_version old_commit old_version
    new_commit="$(git -C "$tmpdir/repo" rev-parse HEAD)"
    new_version="$(tr -d '[:space:]' < "$tmpdir/repo/VERSION")"
    old_commit="$(cat "$STATE_COMMIT" 2>/dev/null || true)"
    old_version="$(cat "$STATE_VERSION" 2>/dev/null || true)"

    if [[ -z "$old_version" && -f "$TARGET_QS/VERSION" ]]; then
        old_version="$(tr -d '[:space:]' < "$TARGET_QS/VERSION")"
    fi

    printf '[diag] installed_version=%s installed_commit=%s target_version=%s target_commit=%s\n' \
        "${old_version:-unknown}" "${old_commit:-unknown}" "$new_version" "$new_commit"

    if [[ -n "$old_commit" && "$old_commit" == "$new_commit" ]]; then
        printf 'Already up to date: Personaboi v%s (%s)\n' "$new_version" "${new_commit:0:7}"
        return 0
    fi

    if [[ -f "$tmpdir/repo/setup/update-hook.sh" ]]; then
        echo "Running v$new_version update preparation..."
        PBOI_PARENT_LOG="$PBOI_LOG_FILE" bash "$tmpdir/repo/setup/update-hook.sh"
    fi

    mkdir -p "$STATE_DIR/backups" "$TARGET_HYPR" "$TARGET_ENV" "$HOME/.local/bin"

    local backup="$STATE_DIR/backups/previous"
    rm -rf "$backup"
    mkdir -p "$backup"

    echo "Backing up current Personaboi configuration..."
    if [[ -d "$TARGET_QS" ]]; then
        rsync -a "$TARGET_QS/" "$backup/persona/"
    fi
    if [[ -f "$TARGET_HYPR/hyprland.conf" ]]; then
        mkdir -p "$backup/hypr"
        cp -a "$TARGET_HYPR/hyprland.conf" "$backup/hypr/hyprland.conf"
    fi
    if [[ -f "$TARGET_ENV/qt.conf" ]]; then
        mkdir -p "$backup/environment.d"
        cp -a "$TARGET_ENV/qt.conf" "$backup/environment.d/qt.conf"
    fi

    local qs_was_running=0
    if pgrep -x qs >/dev/null 2>&1; then
        qs_was_running=1
    fi

    echo "Applying Personaboi v$new_version..."
    mkdir -p "$TARGET_QS"
    rsync -a --delete \
        --exclude '.git/' \
        --exclude 'setup/' \
        --exclude 'docs/' \
        "$tmpdir/repo/" "$TARGET_QS/"

    sed "s#__HOME__#$HOME#g" "$tmpdir/repo/setup/hyprland.conf.in" > "$TARGET_HYPR/hyprland.conf"
    cp "$tmpdir/repo/setup/qt.conf" "$TARGET_ENV/qt.conf"
    install -Dm755 "$tmpdir/repo/setup/pboi" "$CLI_TARGET"

    local hypr_verify_log="$LOG_DIR/hyprland-verify-latest.log"
    if command -v Hyprland >/dev/null 2>&1; then
        if ! Hyprland --verify-config >"$hypr_verify_log" 2>&1; then
            echo "Hyprland config verification failed. Restoring previous configuration..." >&2
            if [[ -d "$backup/persona" ]]; then
                rm -rf "$TARGET_QS"
                mkdir -p "$TARGET_QS"
                rsync -a "$backup/persona/" "$TARGET_QS/"
            fi
            if [[ -f "$backup/hypr/hyprland.conf" ]]; then
                cp "$backup/hypr/hyprland.conf" "$TARGET_HYPR/hyprland.conf"
            fi
            if [[ -f "$backup/environment.d/qt.conf" ]]; then
                cp "$backup/environment.d/qt.conf" "$TARGET_ENV/qt.conf"
            fi
            cat "$hypr_verify_log" >&2 || true
            exit 1
        fi
    fi

    printf '%s\n' "$new_commit" > "$STATE_COMMIT"
    printf '%s\n' "$new_version" > "$STATE_VERSION"

    if command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
    fi

    if [[ "$qs_was_running" -eq 1 ]]; then
        pkill -x qs >/dev/null 2>&1 || true
        nohup qs -c "$TARGET_QS" >"$LOG_DIR/quickshell-latest.log" 2>&1 &
    fi

    printf '\nUpdated: %s -> v%s\n' "${old_version:-unknown}" "$new_version"
    printf 'Commit: %s\n\n' "${new_commit:0:7}"
    echo "Updates pulled:"

    if [[ -n "$old_commit" ]] && git -C "$tmpdir/repo" cat-file -e "$old_commit^{commit}" 2>/dev/null; then
        if [[ -n "$(git -C "$tmpdir/repo" log --format='%h %s' "$old_commit..$new_commit")" ]]; then
            git -C "$tmpdir/repo" log --reverse --format='  %h  %s' "$old_commit..$new_commit"
        else
            echo "  No new commit messages to show."
        fi
    else
        git -C "$tmpdir/repo" log -5 --format='  %h  %s'
    fi

    printf '\nPersonaboi v%s is now active.\n' "$new_version"
    if [[ "$qs_was_running" -eq 1 ]]; then
        echo "Quickshell was restarted automatically."
        echo "Quickshell log: $LOG_DIR/quickshell-latest.log"
    fi
}

case "${1:-help}" in
    update)
        update_personaboi
        ;;
    version|--version|-v)
        print_version
        ;;
    changelog)
        show_changelog
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $1" >&2
        show_help >&2
        exit 2
        ;;
esac
